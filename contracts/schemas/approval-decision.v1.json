{
  "$defs": {
    "ApprovalValue": {
      "enum": [
        "APPROVED",
        "REJECTED"
      ],
      "title": "ApprovalValue",
      "type": "string"
    }
  },
  "$id": "https://coldchain-sentinel.local/contracts/approval-decision.v1.json",
  "additionalProperties": false,
  "properties": {
    "approvalId": {
      "format": "uuid",
      "title": "Approvalid",
      "type": "string"
    },
    "correlationId": {
      "format": "uuid",
      "title": "Correlationid",
      "type": "string"
    },
    "decidedAt": {
      "format": "date-time",
      "title": "Decidedat",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ApprovalValue"
    },
    "eventId": {
      "format": "uuid",
      "title": "Eventid",
      "type": "string"
    },
    "incidentId": {
      "format": "uuid",
      "title": "Incidentid",
      "type": "string"
    },
    "occurredAt": {
      "format": "date-time",
      "title": "Occurredat",
      "type": "string"
    },
    "policyVersion": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Policyversion",
      "type": "string"
    },
    "producer": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "rationale": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "recommendationHash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Recommendationhash",
      "type": "string"
    },
    "recommendationId": {
      "format": "uuid",
      "title": "Recommendationid",
      "type": "string"
    },
    "reviewerIdentity": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Revieweridentity",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "eventId",
    "correlationId",
    "occurredAt",
    "producer",
    "approvalId",
    "recommendationId",
    "incidentId",
    "reviewerIdentity",
    "decision",
    "decidedAt",
    "rationale",
    "recommendationHash",
    "policyVersion"
  ],
  "title": "approval-decision.v1",
  "type": "object"
}
