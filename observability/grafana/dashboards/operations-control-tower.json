{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "links": [{"title": "Jaeger traces", "url": "http://localhost:16687", "targetBlank": true}],
  "panels": [
    {"id": 1, "title": "API request rate", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (route, status_class) (rate(coldchain_api_requests_total[5m]))", "legendFormat": "{{route}} {{status_class}}"}]},
    {"id": 2, "title": "API p95 latency", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(coldchain_api_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}"}]},
    {"id": 3, "title": "Worker throughput", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}, "targets": [{"expr": "sum by (outcome) (rate(coldchain_worker_events_total[5m]))", "legendFormat": "{{outcome}}"}]},
    {"id": 4, "title": "Dead-letter events", "type": "stat", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}, "targets": [{"expr": "sum(increase(coldchain_worker_events_total{outcome=\"dlq\"}[15m]))"}]},
    {"id": 5, "title": "Incidents created", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}, "targets": [{"expr": "sum by (severity) (rate(coldchain_incidents_created_total[5m]))", "legendFormat": "{{severity}}"}]},
    {"id": 6, "title": "Current incident state", "type": "bargauge", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}, "targets": [{"expr": "sum by (state) (coldchain_incidents_current)", "legendFormat": "{{state}}"}]},
    {"id": 7, "title": "Commands and simulated actions", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}, "targets": [{"expr": "sum by (action) (rate(coldchain_commands_created_total[5m]))", "legendFormat": "command {{action}}"}, {"expr": "sum by (outcome) (rate(coldchain_simulated_actions_total[5m]))", "legendFormat": "action {{outcome}}"}]},
    {"id": 8, "title": "Active API requests", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}, "targets": [{"expr": "sum by (route) (coldchain_api_active_requests)", "legendFormat": "{{route}}"}]}
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["coldchain", "operations", "local-demo"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Operations Control Tower",
  "uid": "coldchain-operations",
  "version": 1
}
