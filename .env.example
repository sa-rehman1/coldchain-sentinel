# Safe local-development placeholders only. Never use these values outside local development.
COLDCHAIN_ENVIRONMENT=local
COLDCHAIN_SERVICE_NAME=coldchain-control-plane
COLDCHAIN_LOG_LEVEL=INFO
COLDCHAIN_DATABASE_URL=postgresql+asyncpg://coldchain:change-me-local-only@postgres:5432/coldchain
COLDCHAIN_DATABASE_CONNECT_TIMEOUT_SECONDS=5
COLDCHAIN_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
COLDCHAIN_KAFKA_TELEMETRY_TOPIC=coldchain.telemetry.v1
COLDCHAIN_KAFKA_DEAD_LETTER_TOPIC=coldchain.telemetry.dlq.v1
COLDCHAIN_KAFKA_CONSUMER_GROUP=coldchain-telemetry-worker-v1
COLDCHAIN_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
COLDCHAIN_GOVERNANCE_KILL_SWITCH_ACTIVE=false
COLDCHAIN_DEMO_MODE_ENABLED=true
COLDCHAIN_POSTGRES_USER=coldchain
COLDCHAIN_POSTGRES_PASSWORD=change-me-local-only
COLDCHAIN_POSTGRES_DB=coldchain
COLDCHAIN_POSTGRES_HOST_PORT=5432
COLDCHAIN_KAFKA_HOST_PORT=9092
COLDCHAIN_API_HOST_PORT=8000
COLDCHAIN_FRONTEND_HOST_PORT=4173
VITE_CONTROL_TOWER_DATA_SOURCE=api
COLDCHAIN_QDRANT_HOST_PORT=6333
COLDCHAIN_QDRANT_URL=http://qdrant:6333
COLDCHAIN_QDRANT_COLLECTION=coldchain_sop_v1
COLDCHAIN_EMBEDDING_PROVIDER=deterministic
COLDCHAIN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
COLDCHAIN_METRICS_ENABLED=true
COLDCHAIN_WORKER_METRICS_HOST=0.0.0.0
COLDCHAIN_WORKER_METRICS_PORT=9100
COLDCHAIN_WORKER_METRICS_HOST_PORT=18005
COLDCHAIN_OTEL_TRACING_ENABLED=false
COLDCHAIN_OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
COLDCHAIN_OTEL_EXPORT_TIMEOUT_SECONDS=2
COLDCHAIN_PROMETHEUS_HOST_PORT=19090
COLDCHAIN_GRAFANA_HOST_PORT=13001
COLDCHAIN_JAEGER_UI_HOST_PORT=16687
COLDCHAIN_JAEGER_OTLP_HTTP_HOST_PORT=14318
COLDCHAIN_LOCAL_GRAFANA_URL=http://127.0.0.1:13001
COLDCHAIN_LOCAL_PROMETHEUS_URL=http://127.0.0.1:19090
COLDCHAIN_LOCAL_JAEGER_URL=http://127.0.0.1:16687
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY_ENV=GROQ_API_KEY
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=low
LLM_LIVE_CALLS_ENABLED=false
LLM_BILLING_MODE=free_tier
# Create this value yourself in the Groq console; keep it only in an untracked local .env.
GROQ_API_KEY=
